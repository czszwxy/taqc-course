      "options": [
        { "text": "`\"invalid\" in message`", "correct": true },
        { "text": "`message == \"invalid\"`", "explain": "Це перевірка повного збігу, а не входження." },
        { "text": "`message.startswith(\"invalid\")`" }
      ]
    },
    {
      "id": "join",
      "kind": "text",
