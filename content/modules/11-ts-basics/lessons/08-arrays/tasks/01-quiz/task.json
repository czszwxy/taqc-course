  "hints": ["Згадай таблицю методів: які змінюють масив, а які повертають новий."],
  "questions": [
    {
      "id": "last",
      "kind": "single",
      "text": "Як отримати **останній** елемент масиву `items`?",
      "options": [
        { "text": "`items[items.length - 1]`", "correct": true },
        { "text": "`items[items.length]`", "explain": "Це індекс «за межами» масиву, результат undefined." },
        { "text": "`items[-1]`", "explain": "Від'ємні індекси в [] не працюють. Для цього є items.at(-1)." }
      ]
    },
    {
      "id": "reference",
      "kind": "text",
      "text": "Що виведе код?",
      "code": "const a = [1, 2];\nconst b = a;\nb.push(3);\nconsole.log(a.length);",
      "accept": ["3"],
      "explanation": "b — це те саме посилання, що й a. push через b змінив той самий масив."
    },
    {
      "id": "slice",
      "kind": "single",
      "text": "Що поверне `['a', 'b', 'c', 'd'].slice(1, 3)`?",
      "options": [
        { "text": "`['b', 'c']`", "correct": true, "explain": "end (3) не включається." },
        { "text": "`['b', 'c', 'd']`" },
        { "text": "`['a', 'b', 'c']`" }
      ]
    },
    {
      "id": "mutating",
      "kind": "multiple",
      "text": "Які методи **змінюють** вихідний масив?",
      "options": [
        { "text": "`push`", "correct": true },
        { "text": "`pop`", "correct": true },
        { "text": "`splice`", "correct": true },
        { "text": "`slice`", "explain": "slice повертає новий масив." },
        { "text": "`join`", "explain": "join повертає рядок." }
      ]
    },
    {
      "id": "equality",
      "kind": "single",
      "text": "Що поверне `[1, 2] === [1, 2]`?",
      "options": [
        { "text": "`false`", "correct": true, "explain": "Це два різні масиви в пам'яті, а === порівнює посилання." },
        { "text": "`true`" }
      ]
    },
    {
      "id": "join",
      "kind": "text",
      "text": "Що поверне `['smoke', 'api'].join(' | ')`?",
      "accept": ["smoke | api"],
      "explanation": "join склеює елементи в рядок через роздільник."
    },
    {
      "id": "indexof-missing",
      "kind": "text",
      "text": "Що поверне `['a', 'b'].indexOf('z')`?",
