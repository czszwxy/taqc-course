{
  "name": "my-university",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "my-university: self-study courses for IT professions, from zero to your first job.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx scripts/check-sync-merge.ts && tsx scripts/check-workdesk.ts && tsx scripts/check-accounts.ts",
    "validate": "tsx scripts/validate-content.ts",
    "validate:lab": "tsx scripts/validate-lab.ts",
    "lab": "playwright test -c lab",
    "lab:report": "playwright show-report lab/playwright-report",
    "lab:setup": "tsx scripts/lab-setup.ts",
    "lab:python-setup": "tsx scripts/lab-python-setup.ts",
    "lab:py": "tsx scripts/lab-python.ts",
    "lab:py-codegen": "tsx scripts/lab-python.ts playwright codegen --target python-pytest",
    "lab:py-trace": "tsx scripts/lab-python.ts playwright show-trace",
    "lab:py-api": "tsx scripts/lab-python.ts api",
    "lab:py-django": "tsx scripts/lab-python.ts django"
  },
  "dependencies": {
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "monaco-editor": "0.52.2",
    "pyodide": "^314.0.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.6.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "sql.js": "^1.12.0",
    "typescript": "~5.8.3",
    "zod": "^3.25.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.1.8",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.5.0",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.8",
    "tsx": "^4.19.4",
    "vite": "^6.3.5"
  }
}
